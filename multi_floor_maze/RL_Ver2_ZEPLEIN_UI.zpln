      "text": "%pyspark\n# # Example usage (run manually, không tự động train nặng khi mở notebook)\n# #\n# dqn_model, dqn_summary, dqn_details \u003d train_dqn_baseline(\n#     level\u003d\u0027target\u0027,\n#     total_timesteps\u003d120000,\n#     train_seed_pool\u003dlist(range(0, 512)),\n#     eval_seeds\u003dEVAL_SEED_POOL,\n# )\n# dqn_summary\n\n# ppo_model, ppo_summary, ppo_details \u003d train_ppo_lstm(\n#     level\u003d\u0027target\u0027,\n#     total_timesteps\u003d160000,\n#     train_seed_pool\u003dlist(range(0, 512)),\n#     eval_seeds\u003dEVAL_SEED_POOL,\n#     n_envs\u003d4,\n# )\n# ppo_summary\n\n# comparison, models, details \u003d run_generalization_benchmark(\n#     level\u003d\u0027target\u0027,\n#     total_timesteps_dqn\u003d120000,\n#     total_timesteps_ppo\u003d160000,\n#     train_seed_pool\u003dlist(range(0, 512)),\n#     eval_seeds\u003dEVAL_SEED_POOL,\n# )\n# comparison\n",
