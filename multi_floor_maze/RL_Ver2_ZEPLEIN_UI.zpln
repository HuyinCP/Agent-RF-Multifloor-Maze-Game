      "text": "%pyspark\nimport numpy as np\n\n\ndef evaluate_generalization(model, level\u003d\u0027target\u0027, eval_seeds\u003dNone, deterministic\u003dTrue, recurrent\u003dFalse):\n    eval_seeds \u003d list(eval_seeds or EVAL_SEED_POOL)\n    benchmark \u003d level in (\u0027target\u0027, \u0027benchmark\u0027)\n    eval_env \u003d NeuroInfiltratorEnv(get_refactor_level_config(level, benchmark\u003dbenchmark))\n    results \u003d []\n    for seed in eval_seeds:\n        obs, info \u003d eval_env.reset(seed\u003dseed)\n        done \u003d False\n        trunc \u003d False\n        total_reward \u003d 0.0\n        lstm_state \u003d None\n        episode_start \u003d np.ones((1,), dtype\u003dbool)\n        while not (done or trunc):\n            if recurrent:\n                action, lstm_state \u003d model.predict(obs, state\u003dlstm_state, episode_start\u003depisode_start, deterministic\u003ddeterministic)\n            else:\n                action, _ \u003d model.predict(obs, deterministic\u003ddeterministic)\n            obs, reward, done, trunc, info \u003d eval_env.step(action)\n            total_reward +\u003d reward\n            episode_start \u003d np.array([done or trunc], dtype\u003dbool)\n        results.append({\n            \u0027seed\u0027: seed,\n            \u0027success\u0027: bool(info.get(\u0027success\u0027, info.get(\u0027win\u0027, False))),\n            \u0027return\u0027: float(total_reward),\n            \u0027steps\u0027: int(info.get(\u0027steps\u0027, 0)),\n            \u0027keys\u0027: int(info.get(\u0027key_count\u0027, info.get(\u0027keys\u0027, 0))),\n            \u0027doors_remaining\u0027: int(info.get(\u0027doors_remaining\u0027, 0)),\n            \u0027explored\u0027: int(info.get(\u0027explored\u0027, 0)),\n        })\n    summary \u003d {\n        \u0027success_rate\u0027: float(np.mean([row[\u0027success\u0027] for row in results])) if results else 0.0,\n        \u0027avg_return\u0027: float(np.mean([row[\u0027return\u0027] for row in results])) if results else 0.0,\n        \u0027avg_steps\u0027: float(np.mean([row[\u0027steps\u0027] for row in results])) if results else 0.0,\n        \u0027avg_keys\u0027: float(np.mean([row[\u0027keys\u0027] for row in results])) if results else 0.0,\n        \u0027avg_doors_remaining\u0027: float(np.mean([row[\u0027doors_remaining\u0027] for row in results])) if results else 0.0,\n        \u0027avg_explored\u0027: float(np.mean([row[\u0027explored\u0027] for row in results])) if results else 0.0,\n        \u0027eval_seeds\u0027: eval_seeds,\n    }\n    return summary, results\n\n\ndef train_dqn_baseline(level\u003d\u0027target\u0027, total_timesteps\u003d120000, train_seed_pool\u003dNone, eval_seeds\u003dNone, frame_stack_k\u003d4, progress_bar\u003dFalse):\n    env \u003d DummyVecEnv([make_training_env(level\u003dlevel, train_seed_pool\u003dtrain_seed_pool, frame_stack_k\u003dframe_stack_k)])\n    env \u003d VecMonitor(env)\n    policy_kwargs \u003d {\n        \u0027features_extractor_class\u0027: NeuroDictExtractor,\n        \u0027features_extractor_kwargs\u0027: {\u0027features_dim\u0027: 256},\n        \u0027net_arch\u0027: [256, 128],\n    }\n    model \u003d DQN(\n        \u0027MultiInputPolicy\u0027,\n        env,\n        learning_rate\u003d1e-4,\n        buffer_size\u003d100000,\n        learning_starts\u003d5000,\n        batch_size\u003d128,\n        gamma\u003d0.99,\n        train_freq\u003d4,\n        gradient_steps\u003d1,\n        target_update_interval\u003d1000,\n        exploration_fraction\u003d0.25,\n        exploration_final_eps\u003d0.05,\n        policy_kwargs\u003dpolicy_kwargs,\n        verbose\u003d1,\n    )\n    model.learn(total_timesteps\u003dtotal_timesteps, progress_bar\u003dprogress_bar)\n    summary, details \u003d evaluate_generalization(model, level\u003dlevel, eval_seeds\u003deval_seeds, recurrent\u003dFalse)\n    summary[\u0027model\u0027] \u003d \u0027DQN\u0027\n    summary[\u0027frame_stack_k\u0027] \u003d frame_stack_k\n    return model, summary, details\n\n\ndef train_ppo_lstm(level\u003d\u0027target\u0027, total_timesteps\u003d160000, train_seed_pool\u003dNone, eval_seeds\u003dNone, n_envs\u003d4, progress_bar\u003dFalse):\n    env \u003d DummyVecEnv([make_training_env(level\u003dlevel, train_seed_pool\u003dtrain_seed_pool) for _ in range(n_envs)])\n    env \u003d VecMonitor(env)\n    policy_kwargs \u003d {\n        \u0027features_extractor_class\u0027: NeuroDictExtractor,\n        \u0027features_extractor_kwargs\u0027: {\u0027features_dim\u0027: 256},\n        \u0027lstm_hidden_size\u0027: 128,\n        \u0027n_lstm_layers\u0027: 1,\n        \u0027shared_lstm\u0027: False,\n        \u0027enable_critic_lstm\u0027: True,\n        \u0027net_arch\u0027: {\u0027pi\u0027: [128], \u0027vf\u0027: [128]},\n    }\n    model \u003d RecurrentPPO(\n        \u0027MultiInputLstmPolicy\u0027,\n        env,\n        learning_rate\u003d3e-4,\n        n_steps\u003d128,\n        batch_size\u003d128,\n        n_epochs\u003d4,\n        gamma\u003d0.99,\n        gae_lambda\u003d0.95,\n        clip_range\u003d0.2,\n        ent_coef\u003d0.01,\n        vf_coef\u003d0.5,\n        max_grad_norm\u003d0.5,\n        policy_kwargs\u003dpolicy_kwargs,\n        verbose\u003d1,\n    )\n    model.learn(total_timesteps\u003dtotal_timesteps, progress_bar\u003dprogress_bar)\n    summary, details \u003d evaluate_generalization(model, level\u003dlevel, eval_seeds\u003deval_seeds, recurrent\u003dTrue)\n    summary[\u0027model\u0027] \u003d \u0027PPO_LSTM\u0027\n    summary[\u0027n_envs\u0027] \u003d n_envs\n    return model, summary, details\n\n\ndef run_generalization_benchmark(level\u003d\u0027target\u0027, total_timesteps_dqn\u003d120000, total_timesteps_ppo\u003d160000, train_seed_pool\u003dNone, eval_seeds\u003dNone, progress_bar\u003dFalse):\n    eval_seeds \u003d list(eval_seeds or EVAL_SEED_POOL)\n    dqn_model, dqn_summary, dqn_details \u003d train_dqn_baseline(\n        level\u003dlevel,\n        total_timesteps\u003dtotal_timesteps_dqn,\n        train_seed_pool\u003dtrain_seed_pool,\n        eval_seeds\u003deval_seeds,\n        progress_bar\u003dprogress_bar,\n    )\n    ppo_model, ppo_summary, ppo_details \u003d train_ppo_lstm(\n        level\u003dlevel,\n        total_timesteps\u003dtotal_timesteps_ppo,\n        train_seed_pool\u003dtrain_seed_pool,\n        eval_seeds\u003deval_seeds,\n        progress_bar\u003dprogress_bar,\n    )\n    comparison \u003d {\n        \u0027eval_seeds\u0027: eval_seeds,\n        \u0027dqn\u0027: dqn_summary,\n        \u0027ppo_lstm\u0027: ppo_summary,\n    }\n    return comparison, {\u0027dqn\u0027: dqn_model, \u0027ppo_lstm\u0027: ppo_model}, {\u0027dqn\u0027: dqn_details, \u0027ppo_lstm\u0027: ppo_details}\n\n\nprint(\u0027DQN baseline + PPO-LSTM benchmark functions ready\u0027)\n",
