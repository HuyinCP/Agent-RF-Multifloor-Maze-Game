      "text": "%pyspark\nimport numpy as np\nfrom PIL import Image, ImageDraw, ImageFont\nimport random\nimport gymnasium as gym\nfrom gymnasium import spaces\nfrom collections import deque\n\nclass ObservationBuilder:\n    \"Builds (16,V,V) visual tensor + (15,) vector. Each entity type has its own channel.\"\n    N_CHANNELS \u003d 16\n    N_VEC \u003d 15\n    def __init__(self,vr\u003d4): self.vr\u003dvr; self.vs\u003d2*vr+1\n        \n    def build(self,grid,agent,enemies,bpos,lasers,nf,target_3d,max_steps\u003d200):\n        vs,vr\u003dself.vs,self.vr; h,w\u003dgrid.shape\n        obs\u003dnp.zeros((self.N_CHANNELS,vs,vs),dtype\u003dnp.float32)\n        # ── Tile scan (local view) ──\n        for dy in range(-vr,vr+1):\n            for dx in range(-vr,vr+1):\n                gx,gy\u003dagent.x+dx,agent.y+dy; oy,ox\u003ddy+vr,dx+vr\n                if 0\u003c\u003dgx\u003cw and 0\u003c\u003dgy\u003ch:\n                    t\u003dint(grid[gy][gx])\n                    if   t\u003d\u003dTile.WALL:        obs[0][oy][ox]\u003d1.0  \n                    elif t\u003d\u003dTile.TRAP:        obs[1][oy][ox]\u003d1.0  \n                    elif t\u003d\u003dTile.DOOR:        obs[2][oy][ox]\u003d1.0  \n                    elif t\u003d\u003dTile.STAIR_UP:    obs[3][oy][ox]\u003d1.0  \n                    elif t\u003d\u003dTile.STAIR_DOWN:  obs[4][oy][ox]\u003d1.0  \n                    elif t\u003d\u003dTile.GOAL:        obs[5][oy][ox]\u003d1.0  \n                    elif t\u003d\u003dTile.KEY:         obs[6][oy][ox]\u003d1.0  \n                    elif t\u003d\u003dTile.HEALTH_PACK: obs[7][oy][ox]\u003d1.0  \n                    elif t\u003d\u003dTile.AMMO_PACK:   obs[8][oy][ox]\u003d1.0  \n                    if (gx, gy, agent.floor) in agent.visited:\n                        obs[15][oy][ox] \u003d 1.0\n                else:\n                    obs[0][oy][ox]\u003d1.0  \n        # ── Agent center ──\n        obs[9][vr][vr]\u003d1.0\n        \n        # ── Enemies, Projectiles, Lasers ──\n        ETYPE_CH \u003d {\u0027patrol\u0027: 10, \u0027chaser\u0027: 11, \u0027sniper\u0027: 12}\n        min_enemy_dist \u003d float(\u0027inf\u0027)\n        for e in enemies:\n            if e.alive and e.floor\u003d\u003dagent.floor:\n                ed \u003d abs(e.x - agent.x) + abs(e.y - agent.y)\n                if ed \u003c min_enemy_dist: min_enemy_dist \u003d ed\n                ox,oy\u003de.x-agent.x+vr,e.y-agent.y+vr\n                if 0\u003c\u003dox\u003cvs and 0\u003c\u003doy\u003cvs:\n                    ch\u003dETYPE_CH.get(e.etype, 10)\n                    obs[ch][oy][ox]\u003d1.0\n                    \n        for bx,by,owner in bpos:\n            ox,oy\u003dbx-agent.x+vr,by-agent.y+vr\n            if 0\u003c\u003dox\u003cvs and 0\u003c\u003doy\u003cvs: obs[13][oy][ox]\u003d1.0\n        for lx,ly in lasers:\n            ox,oy\u003dlx-agent.x+vr,ly-agent.y+vr\n            if 0\u003c\u003dox\u003cvs and 0\u003c\u003doy\u003cvs: obs[14][oy][ox]\u003d1.0\n\n        gx, gy, gf \u003d target_3d \n        if gf \u003d\u003d agent.floor:\n            tdx \u003d (gx - agent.x) / max(1, w - 1)\n            tdy \u003d (gy - agent.y) / max(1, h - 1)\n            tdz \u003d 0.0\n        else:\n            bd, bp \u003d 1e9, (agent.x, agent.y)\n            target_stair \u003d Tile.STAIR_UP if gf \u003e agent.floor else Tile.STAIR_DOWN\n            for sy in range(h):\n                for sx in range(w):\n                    if grid[sy][sx] \u003d\u003d target_stair:\n                        d \u003d abs(sx - agent.x) + abs(sy - agent.y)\n                        if d \u003c bd: bd, bp \u003d d, (sx, sy)\n            tdx \u003d (bp[0] - agent.x) / max(1, w - 1)\n            tdy \u003d (bp[1] - agent.y) / max(1, h - 1)\n            tdz \u003d (gf - agent.floor) / max(1, nf - 1)\n            \n        true_manhattan \u003d abs(gx - agent.x) + abs(gy - agent.y) + abs(gf - agent.floor) * 20\n        target_dist \u003d (1.0 - true_manhattan / max(1, w + h + nf * 20)) * 2 - 1\n\n        time_rem \u003d (1.0 - agent.steps / max(1, max_steps)) * 2 - 1\n        cur_tile \u003d int(grid[agent.y][agent.x])\n        on_stair \u003d 1.0 if cur_tile in (Tile.STAIR_UP, Tile.STAIR_DOWN) else -1.0\n        enemy_prox \u003d -1.0 if min_enemy_dist \u003d\u003d float(\u0027inf\u0027) else (1.0 - min_enemy_dist / max(1, w + h)) * 2 - 1\n        \n        vec\u003dnp.array([\n            (agent.hp/max(1,agent.max_hp))*2 - 1,              \n            (agent.ammo/max(1,agent.max_ammo))*2 - 1,          \n            (agent.stamina/max(1,agent.max_stamina))*2 - 1,    \n            1.0 if agent.keys \u003e 0 else -1.0,                  \n            (agent.noise_level/10.0)*2 - 1,                    \n            (agent.floor/max(1,nf-1) if nf\u003e1 else 0.0)*2 - 1, \n            np.clip(tdx,-1,1), np.clip(tdy,-1,1), np.clip(tdz,-1,1), \n            float(agent.last_dir[0]), float(agent.last_dir[1]),\n            np.clip(time_rem,-1,1),                            \n            np.clip(target_dist,-1,1),                         \n            on_stair,                                          \n            np.clip(enemy_prox,-1,1)                           \n        ], dtype\u003dnp.float32)\n        return obs,vec\n\n\nclass NeuroInfiltratorEnv(gym.Env):\n    \"Neuro-Infiltrator: Multi-Floor Protocol. obs\u003dDict(visual,vector) action\u003dDiscrete(10)\"\n    metadata\u003d{\u0027render_modes\u0027:[\u0027rgb_array\u0027]}\n    ACT_NAMES\u003d[\u0027UP\u0027,\u0027DOWN\u0027,\u0027LEFT\u0027,\u0027RIGHT\u0027,\u0027SHOOT_U\u0027,\u0027SHOOT_D\u0027,\u0027SHOOT_L\u0027,\u0027SHOOT_R\u0027,\u0027DASH\u0027,\u0027STAIRS\u0027]\n\n    def __init__(self,config\u003dNone,render_mode\u003d\u0027rgb_array\u0027):\n        super().__init__()\n        self.cfg\u003dconfig or {}; self.render_mode\u003drender_mode\n        vr\u003dself.cfg.get(\u0027view_radius\u0027,4); self.vr\u003dvr; vs\u003d2*vr+1\n        self.observation_space\u003dspaces.Dict({\n            \u0027visual\u0027:spaces.Box(0,1,(16,vs,vs),np.float32),\n            \u0027vector\u0027:spaces.Box(-1,1,(15,),np.float32)})\n        self.action_space\u003dspaces.Discrete(10)\n        self.obs_builder\u003dObservationBuilder(vr)\n        \n        # Hàm thưởng KHẮC NGHIỆT (Không dung túng sự hèn nhát)\n        self.R\u003d{\u0027step\u0027:-0.1,\u0027wall\u0027:-0.5,\u0027goal\u0027:50.0,\u0027key\u0027:5.0,\u0027door\u0027:5.0,\u0027door_lk\u0027:-0.5,\n               \u0027kill\u0027:10.0,\u0027dmg\u0027:-5.0,\u0027death\u0027:-30.0,\u0027stairs\u0027:3.0,\u0027explore\u0027:0.2,\u0027trap\u0027:-5.0,\n               \u0027hp\u0027:3.0,\u0027ammo\u0027:2.0,\u0027approach\u0027:0.5, \u0027shoot\u0027: -0.5}\n        \n        self.R.update(self.cfg.get(\u0027rewards\u0027,{}))\n        self.max_steps\u003dself.cfg.get(\u0027max_steps\u0027,200)\n        self.floors\u003dNone; self.agent\u003dNone; self.enemies\u003d[]; self.goal\u003d(0,0,0)\n        self.done\u003dFalse; self.win\u003dFalse; self.total_reward\u003d0; self._lasers\u003d[]\n\n    def reset(self,seed\u003dNone,options\u003dNone):\n        if options and options.get(\u0027same_map\u0027) and hasattr(self, \u0027initial_map_data\u0027):\n            md\u003dself.initial_map_data\n        elif options and \u0027map_data\u0027 in options:\n            md\u003doptions[\u0027map_data\u0027]\n        else:\n            mg\u003dProceduralMapGenerator(seed); md\u003dmg.generate(self.cfg)\n        self.initial_map_data \u003d md\n        self.floors\u003d[g.copy() for g in md[\u0027floors\u0027]]\n        self.nf\u003dmd[\u0027n_floors\u0027]; self.mw\u003dmd[\u0027width\u0027]; self.mh\u003dmd[\u0027height\u0027]\n        sx,sy,sf\u003dmd[\u0027start\u0027]; self.goal\u003dmd[\u0027goal\u0027]\n        hp\u003dself.cfg.get(\u0027agent_hp\u0027,3); ammo\u003dself.cfg.get(\u0027agent_ammo\u0027,3)\n        stam\u003dself.cfg.get(\u0027agent_stamina\u0027,3)\n        self.agent\u003dAgentState(sx,sy,sf,hp,ammo,stam)\n        self.agent.max_ammo\u003dself.cfg.get(\u0027agent_max_ammo\u0027,5)\n        self.enemies\u003d[]\n        for ec in self.cfg.get(\u0027enemies\u0027,[]):\n            ef\u003dec.get(\u0027floor\u0027,0); g\u003dself.floors[ef]\n            ft\u003d[(x,y) for y in range(self.mh) for x in range(self.mw) if g[y][x]\u003d\u003dTile.FLOOR and (x,y)!\u003d(sx,sy)]\n            ex,ey\u003drandom.choice(ft) if ft else (1,1); et\u003dec.get(\u0027type\u0027,\u0027patrol\u0027)\n            if et\u003d\u003d\u0027patrol\u0027:\n                wps\u003d[(ex,ey)]\n                for _ in range(3): wps.append((max(1,min(self.mw-2,ex+random.randint(-4,4))),\n                                               max(1,min(self.mh-2,ey+random.randint(-4,4)))))\n                self.enemies.append(PatrolEnemy(ex,ey,ef,wps))\n            elif et\u003d\u003d\u0027chaser\u0027: self.enemies.append(ChaserEnemy(ex,ey,ef))\n            elif et\u003d\u003d\u0027sniper\u0027: self.enemies.append(SniperEnemy(ex,ey,ef))\n        self.ballistics\u003dBallisticsEngine(); self.stealth\u003dStealthSystem()\n        self.done\u003dFalse; self.win\u003dFalse; self.total_reward\u003d0\n        self.agent.steps\u003d0; self.agent.visited\u003d{(sx,sy,sf)}; self._lasers\u003d[]\n        return self._obs(),self._info()\n\n    def _dynamic_goal(self):\n        if self.agent.keys \u003d\u003d 0:\n            bd, bp \u003d 1e9, None\n            for f, grid in enumerate(self.floors):\n                h, w \u003d grid.shape\n                for sy in range(h):\n                    for sx in range(w):\n                        if grid[sy][sx] \u003d\u003d Tile.KEY:\n                            d \u003d abs(sx - self.agent.x) + abs(sy - self.agent.y) + abs(f - self.agent.floor) * 20\n                            if d \u003c bd: bd, bp \u003d d, (sx, sy, f)\n            if bp: return bp\n        return self.goal\n\n    def _true_distance(self, x, y, f, target_3d):\n        gx, gy, gf \u003d target_3d\n        if x \u003d\u003d gx and y \u003d\u003d gy and f \u003d\u003d gf: \n            return 0\n        from collections import deque\n        q \u003d deque([(x, y, f, 0)])\n        vis \u003d {(x, y, f)}\n        h, w \u003d self.floors[0].shape\n        while q:\n            cx, cy, cf, d \u003d q.popleft()\n            for dx, dy in [(0, 1), (0, -1), (1, 0), (-1, 0)]:\n                nx, ny \u003d cx + dx, cy + dy\n                if 0 \u003c\u003d nx \u003c w and 0 \u003c\u003d ny \u003c h and (nx, ny, cf) not in vis:\n                    t \u003d int(self.floors[cf][ny][nx])\n                    if t !\u003d int(Tile.WALL) and not (t \u003d\u003d int(Tile.DOOR) and self.agent.keys \u003d\u003d 0):\n                        if nx \u003d\u003d gx and ny \u003d\u003d gy and cf \u003d\u003d gf: return d + 1\n                        vis.add((nx, ny, cf))\n                        q.append((nx, ny, cf, d + 1))\n            curr_tile \u003d int(self.floors[cf][cy][cx])\n            if curr_tile \u003d\u003d int(Tile.STAIR_UP) and cf \u003c self.nf - 1:\n                if (cx, cy, cf + 1) not in vis:\n                    if cx \u003d\u003d gx and cy \u003d\u003d gy and cf + 1 \u003d\u003d gf: return d + 1\n                    vis.add((cx, cy, cf + 1))\n                    q.append((cx, cy, cf + 1, d + 1))\n            elif curr_tile \u003d\u003d int(Tile.STAIR_DOWN) and cf \u003e 0:\n                if (cx, cy, cf - 1) not in vis:\n                    if cx \u003d\u003d gx and cy \u003d\u003d gy and cf - 1 \u003d\u003d gf: return d + 1\n                    vis.add((cx, cy, cf - 1))\n                    q.append((cx, cy, cf - 1, d + 1))\n        return 999 \n\n    def step(self,action):\n        if self.done: return self._obs(),0.0,True,False,self._info()\n        \n        dg_old \u003d self._dynamic_goal()\n        phi_old \u003d -self._true_distance(self.agent.x, self.agent.y, self.agent.floor, dg_old)\n        \n        self.agent.old_x, self.agent.old_y \u003d self.agent.x, self.agent.y\n        a\u003dint(action); self.agent.steps+\u003d1; r\u003dself.R[\u0027step\u0027]\n        g\u003dself.floors[self.agent.floor]; self.stealth.calc(a,self.agent)\n        \n        if a in (0,1,2,3):\n            dx,dy\u003dDIR_DELTA[a]; self.agent.last_dir\u003d(dx,dy)\n            r+\u003dself._try_move(self.agent.x+dx,self.agent.y+dy)\n        elif 4\u003c\u003da\u003c\u003d7:\n            dx,dy\u003dDIR_DELTA[a-4]; self.agent.last_dir\u003d(dx,dy)\n            if self.agent.use_ammo():\n                r +\u003d self.R.get(\u0027shoot\u0027, -0.5) \n                self.ballistics.fire(self.agent.x,self.agent.y,self.agent.floor,dx,dy,\u0027agent\u0027,self.cfg.get(\u0027ricochet\u0027,0))\n            else: r+\u003dself.R[\u0027wall\u0027]\n        elif a\u003d\u003d8:\n            if self.agent.use_stamina():\n                dx,dy\u003dself.agent.last_dir\n                for _ in range(2):\n                    nx,ny\u003dself.agent.x+dx,self.agent.y+dy\n                    if self._walk(nx,ny): self.agent.x,self.agent.y\u003dnx,ny\n                    else: break\n            else: r+\u003dself.R[\u0027wall\u0027]\n        elif a\u003d\u003d9:\n            t\u003dg[self.agent.y][self.agent.x]\n            if t\u003d\u003dTile.STAIR_UP and self.agent.floor\u003cself.nf-1:\n                self.agent.floor+\u003d1\n                pk2\u003d(self.agent.x,self.agent.y,self.agent.floor)\n                if pk2 not in self.agent.visited: r+\u003dself.R[\u0027stairs\u0027]\n            elif t\u003d\u003dTile.STAIR_DOWN and self.agent.floor\u003e0:\n                self.agent.floor-\u003d1\n                pk2\u003d(self.agent.x,self.agent.y,self.agent.floor)\n                if pk2 not in self.agent.visited: r+\u003dself.R[\u0027stairs\u0027]\n            else: r+\u003dself.R[\u0027wall\u0027]\n            \n        pk\u003d(self.agent.x,self.agent.y,self.agent.floor)\n        if pk not in self.agent.visited: self.agent.visited.add(pk); r+\u003dself.R[\u0027explore\u0027]\n        \n        dg_new \u003d self._dynamic_goal()\n        phi_new \u003d -self._true_distance(self.agent.x, self.agent.y, self.agent.floor, dg_new)\n        \n        if self.R.get(\u0027approach\u0027, 0) \u003e 0:\n            r +\u003d self.R[\u0027approach\u0027] * ((0.99 * phi_new) - phi_old)\n\n        for ev,_ in self.ballistics.update(g,self.enemies,self.agent):\n            if ev\u003d\u003d\u0027kill\u0027: r+\u003dself.R[\u0027kill\u0027]\n            elif ev\u003d\u003d\u0027agent_hit\u0027: self.agent.damage(1); r+\u003dself.R[\u0027dmg\u0027]\n        self._lasers\u003d[]; npos\u003dself.stealth.npos\n        for e in self.enemies:\n            e.old_x, e.old_y \u003d e.x, e.y\n            eg\u003dself.floors[e.floor] if e.floor\u003cself.nf else g\n            if isinstance(e,SniperEnemy):\n                proj\u003de.update(eg,(self.agent.x,self.agent.y),self.agent.floor,self.agent.noise_level,npos)\n                if proj: self.ballistics.add(proj)\n                self._lasers.extend(e.laser_path)\n            else: e.update(eg,(self.agent.x,self.agent.y),self.agent.floor,self.agent.noise_level,npos)\n        \n        for b in self.ballistics.bullets:\n            if not b.alive: continue\n            obx, oby \u003d b.x - b.dx, b.y - b.dy\n            if b.owner\u003d\u003d\u0027agent\u0027:\n                for e in self.enemies:\n                    if e.alive and e.floor\u003d\u003db.floor:\n                        hit \u003d False\n                        if e.x\u003d\u003db.x and e.y\u003d\u003db.y: hit\u003dTrue\n                        elif e.x\u003d\u003dobx and e.y\u003d\u003doby and getattr(e,\u0027old_x\u0027,-1)\u003d\u003db.x and getattr(e,\u0027old_y\u0027,-1)\u003d\u003db.y: hit\u003dTrue\n                        if hit:\n                            e.hp-\u003d1\n                            if e.hp\u003c\u003d0: e.alive\u003dFalse; r+\u003dself.R[\u0027kill\u0027]\n                            b.alive\u003dFalse; break\n            elif b.floor\u003d\u003dself.agent.floor:\n                hit \u003d False\n                if self.agent.x\u003d\u003db.x and self.agent.y\u003d\u003db.y: hit\u003dTrue\n                elif self.agent.x\u003d\u003dobx and self.agent.y\u003d\u003doby and getattr(self.agent,\u0027old_x\u0027,-1)\u003d\u003db.x and getattr(self.agent,\u0027old_y\u0027,-1)\u003d\u003db.y: hit\u003dTrue\n                if hit:\n                    self.agent.damage(1); r+\u003dself.R[\u0027dmg\u0027]; b.alive\u003dFalse\n\n        for e in self.enemies:\n            if e.alive and e.floor\u003d\u003dself.agent.floor:\n                d\u003dabs(e.x-self.agent.x)+abs(e.y-self.agent.y)\n                if d\u003c\u003d1 and hasattr(e,\u0027state\u0027) and e.state in (\u0027investigate\u0027,\u0027chase\u0027):\n                    self.agent.damage(1); r+\u003dself.R[\u0027dmg\u0027]\n        if self.agent.steps%5\u003d\u003d0: self.agent.regen_stamina()\n        self.stealth.decay(self.agent)\n        term\u003dFalse\n        if not self.agent.alive: r+\u003dself.R[\u0027death\u0027]; term\u003dTrue\n        gx,gy,gf\u003dself.goal\n        if self.agent.x\u003d\u003dgx and self.agent.y\u003d\u003dgy and self.agent.floor\u003d\u003dgf:\n            r+\u003dself.R[\u0027goal\u0027]; term\u003dTrue; self.win\u003dTrue\n        trunc\u003dself.agent.steps\u003e\u003dself.max_steps; self.done\u003dterm or trunc; self.total_reward+\u003dr\n        return self._obs(),float(r),term,trunc,self._info()\n\n    def _try_move(self,nx,ny): \n        g\u003dself.floors[self.agent.floor]; h,w\u003dg.shape\n        if not(0\u003c\u003dnx\u003cw and 0\u003c\u003dny\u003ch): return self.R[\u0027wall\u0027]\n        t\u003dint(g[ny][nx])\n        if t\u003d\u003dTile.WALL: return self.R[\u0027wall\u0027]\n        if t\u003d\u003dTile.DOOR:\n            if self.agent.keys \u003e 0:\n                self.agent.keys -\u003d 1\n                g[ny][nx]\u003dTile.FLOOR\n                self.agent.x,self.agent.y\u003dnx,ny; return self.R[\u0027door\u0027]\n            return self.R[\u0027door_lk\u0027]\n        self.agent.x,self.agent.y\u003dnx,ny; rv\u003d0\n        if t\u003d\u003dTile.TRAP: self.agent.damage(1); rv+\u003dself.R[\u0027trap\u0027]\n        elif t\u003d\u003dTile.KEY:\n            self.agent.keys+\u003d1; g[ny][nx]\u003dTile.FLOOR; rv+\u003dself.R[\u0027key\u0027]\n        elif t\u003d\u003dTile.HEALTH_PACK: self.agent.heal(1); g[ny][nx]\u003dTile.FLOOR; rv+\u003dself.R[\u0027hp\u0027]\n        elif t\u003d\u003dTile.AMMO_PACK: self.agent.add_ammo(2); g[ny][nx]\u003dTile.FLOOR; rv+\u003dself.R[\u0027ammo\u0027]\n        return rv\n\n    def _walk(self,nx,ny): \n        g\u003dself.floors[self.agent.floor]; h,w\u003dg.shape\n        if not(0\u003c\u003dnx\u003cw and 0\u003c\u003dny\u003ch): return False\n        return int(g[ny][nx]) not in (Tile.WALL,Tile.DOOR)\n\n    def _obs(self): \n        g\u003dself.floors[self.agent.floor]; bp\u003dself.ballistics.positions(self.agent.floor)\n        dg \u003d self._dynamic_goal() \n        v,vec\u003dself.obs_builder.build(g,self.agent,self.enemies,bp,self._lasers,self.nf,dg,self.max_steps)\n        return {\u0027visual\u0027:v,\u0027vector\u0027:vec}\n\n    def _info(self): \n        return {\u0027win\u0027:self.win,\u0027steps\u0027:self.agent.steps,\u0027hp\u0027:self.agent.hp,\n                \u0027ammo\u0027:self.agent.ammo,\u0027floor\u0027:self.agent.floor,\u0027keys\u0027:self.agent.keys,\n                \u0027total_reward\u0027:self.total_reward,\u0027enemies_alive\u0027:sum(1 for e in self.enemies if e.alive),\n                \u0027explored\u0027:len(self.agent.visited)}\n    \n    def render(self):\n        cs \u003d 50\n        g \u003d self.floors[self.agent.floor]\n        h, w \u003d g.shape\n        img \u003d Image.new(\u0027RGB\u0027, (w * cs, h * cs), (255, 255, 255))\n        d \u003d ImageDraw.Draw(img)\n        def get_large_font(size):\n            font_paths \u003d [\"arial.ttf\", \"Arial.ttf\", \"DejaVuSans-Bold.ttf\", \"/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf\", \"LiberationSans-Bold.ttf\", \"/usr/share/fonts/truetype/liberation/LiberationSans-Bold.ttf\", \"/System/Library/Fonts/Supplemental/Arial Bold.ttf\"]\n            for path in font_paths:\n                try: return ImageFont.truetype(path, size)\n                except Exception: continue\n            return ImageFont.load_default()\n        font_tile \u003d get_large_font(int(cs * 0.7))\n        font_unit \u003d get_large_font(int(cs * 0.5))\n        TC\u003d{Tile.FLOOR:(250,250,250),Tile.WALL:(40,40,40),Tile.STAIR_UP:(180,180,255),Tile.STAIR_DOWN:(150,150,220),Tile.GOAL:(255,255,100),Tile.TRAP:(255,80,80),Tile.START:(180,255,180),Tile.DOOR:(180,140,100), Tile.KEY:(220,180,80),Tile.HEALTH_PACK:(255,200,200),Tile.AMMO_PACK:(240,240,150)}\n        TL\u003d{Tile.STAIR_UP:\u0027SU\u0027,Tile.STAIR_DOWN:\u0027SD\u0027,Tile.GOAL:\u0027G\u0027,Tile.TRAP:\u0027X\u0027,Tile.START:\u0027S\u0027,Tile.DOOR:\u0027D\u0027, Tile.KEY:\u0027K\u0027,Tile.HEALTH_PACK:\u0027+\u0027,Tile.AMMO_PACK:\u0027A\u0027}\n        for y in range(h):\n            for x in range(w):\n                t\u003dint(g[y][x]); x1,y1\u003dx*cs,y*cs\n                c\u003dTC.get(t,(250,250,250))\n                d.rectangle([x1,y1,x1+cs-2,y1+cs-2],fill\u003dc,outline\u003d(150,150,150))\n                lb\u003dTL.get(t)\n                if lb: d.text((x1 + cs/2, y1 + cs/2), lb, fill\u003d(0,0,0), font\u003dfont_tile, anchor\u003d\"mm\")\n        for e in self.enemies:\n            if isinstance(e,SniperEnemy) and e.charging and e.floor\u003d\u003dself.agent.floor:\n                for lx,ly in e.laser_path: d.rectangle([lx*cs+cs//3,ly*cs+cs//3,lx*cs+2*cs//3,ly*cs+2*cs//3],fill\u003d(255,50,50))\n        EC\u003d{\u0027patrol\u0027:(200,100,200,\u0027P\u0027),\u0027chaser\u0027:(255,50,50,\u0027E\u0027),\u0027sniper\u0027:(255,165,0,\u0027S\u0027)}\n        for e in self.enemies:\n            if e.alive and e.floor\u003d\u003dself.agent.floor:\n                ec\u003dEC.get(e.etype,(150,150,150,\u0027?\u0027))\n                d.ellipse([e.x*cs+4, e.y*cs+4, e.x*cs+cs-6, e.y*cs+cs-6], fill\u003dec[:3], outline\u003d(0,0,0), width\u003d2)\n                d.text((e.x*cs + cs/2, e.y*cs + cs/2), ec[3], fill\u003d(255,255,255), font\u003dfont_unit, anchor\u003d\"mm\")\n        for bx,by,owner in self.ballistics.positions(self.agent.floor):\n            bc\u003d(200,200,0) if owner\u003d\u003d\u0027agent\u0027 else (255,0,0)\n            d.ellipse([bx*cs+cs//3,by*cs+cs//3,bx*cs+2*cs//3,by*cs+2*cs//3],fill\u003dbc)\n        ax,ay \u003d self.agent.x*cs+6, self.agent.y*cs+6\n        ac\u003d(255,100,100) if self.agent.hp\u003c\u003d1 else (100,200,100) if self.agent.keys \u003e 0 else (100,150,255)\n        d.ellipse([ax,ay, ax+cs-12, ay+cs-12], fill\u003dac, outline\u003d(0,0,0), width\u003d2)\n        d.text((self.agent.x*cs + cs/2, self.agent.y*cs + cs/2), \u0027@\u0027, fill\u003d(0,0,0), font\u003dfont_unit, anchor\u003d\"mm\")\n        return np.array(img)\n\n# \u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\n#  VỎ BỌC THỜI GIAN (FRAME STACK WRAPPER)\n# \u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\nclass FrameStackWrapper(gym.Wrapper):\n    \"\"\"Vỏ bọc giúp Agent nhớ được k khung hình gần nhất (Mặc định k\u003d3)\"\"\"\n    def __init__(self, env, k\u003d7):\n        super().__init__(env)\n        self.k \u003d k\n        self.frames_vis \u003d deque([], maxlen\u003dk)\n        self.frames_vec \u003d deque([], maxlen\u003dk)\n        \n        vs \u003d env.observation_space[\u0027visual\u0027].shape[1]\n        self.observation_space \u003d spaces.Dict({\n            \u0027visual\u0027: spaces.Box(0, 1, (16 * k, vs, vs), np.float32),\n            \u0027vector\u0027: spaces.Box(-1, 1, (15 * k,), np.float32)\n        })\n\n    def reset(self, **kwargs):\n        obs, info \u003d self.env.reset(**kwargs)\n        for _ in range(self.k):\n            self.frames_vis.append(obs[\u0027visual\u0027])\n            self.frames_vec.append(obs[\u0027vector\u0027])\n        return self._get_obs(), info\n\n    def step(self, action):\n        obs, r, term, trunc, info \u003d self.env.step(action)\n        self.frames_vis.append(obs[\u0027visual\u0027])\n        self.frames_vec.append(obs[\u0027vector\u0027])\n        return self._get_obs(), r, term, trunc, info\n\n    def _get_obs(self):\n        vis_stacked \u003d np.concatenate(list(self.frames_vis), axis\u003d0) \n        vec_stacked \u003d np.concatenate(list(self.frames_vec), axis\u003d0) \n        return {\u0027visual\u0027: vis_stacked, \u0027vector\u0027: vec_stacked}",
