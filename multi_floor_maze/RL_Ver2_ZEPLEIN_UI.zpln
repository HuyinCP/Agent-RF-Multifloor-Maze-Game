    {
      "text": "%pyspark\nimport copy\n\nTARGET_REWARD_CONTRACT \u003d {\n    \u0027step\u0027: -0.03,\n    \u0027wall\u0027: -0.20,\n    \u0027goal\u0027: 30.0,\n    \u0027key\u0027: 2.0,\n    \u0027door\u0027: 3.0,\n    \u0027door_lk\u0027: -0.30,\n    \u0027kill\u0027: 0.75,\n    \u0027dmg\u0027: -2.0,\n    \u0027death\u0027: -20.0,\n    \u0027stairs\u0027: 0.50,\n    \u0027explore\u0027: 0.03,\n    \u0027trap\u0027: -2.5,\n    \u0027hp\u0027: 0.60,\n    \u0027ammo\u0027: 0.40,\n    \u0027approach\u0027: 0.20,\n    \u0027shoot\u0027: -0.10,\n}\n\nTARGET_SCENARIO \u003d {\n    \u0027name\u0027: \u0027Target Mission (13x13) - 3 Floors, Full Stack\u0027,\n    \u0027width\u0027: 13,\n    \u0027height\u0027: 13,\n    \u0027n_floors\u0027: 3,\n    \u0027max_steps\u0027: 900,\n    \u0027agent_hp\u0027: 10,\n    \u0027agent_ammo\u0027: 8,\n    \u0027agent_max_ammo\u0027: 8,\n    \u0027agent_stamina\u0027: 6,\n    \u0027n_traps\u0027: 10,\n    \u0027n_health\u0027: 4,\n    \u0027n_ammo\u0027: 4,\n    \u0027locks\u0027: [{\u0027k\u0027: 2, \u0027d\u0027: 2}, {\u0027k\u0027: 1, \u0027d\u0027: 1}, {\u0027k\u0027: 0, \u0027d\u0027: 0}],\n    \u0027n_timed_doors\u0027: 0,\n    \u0027toxic_gas\u0027: False,\n    \u0027ricochet\u0027: 0,\n    \u0027start_floor\u0027: 2,\n    \u0027goal_floor\u0027: 0,\n    \u0027required_enemy_types\u0027: [\u0027patrol\u0027, \u0027chaser\u0027, \u0027sniper\u0027],\n    \u0027benchmark_seeds\u0027: [11, 23, 37, 47, 59],\n    \u0027enemies\u0027: [\n        {\u0027type\u0027: \u0027patrol\u0027, \u0027floor\u0027: 2},\n        {\u0027type\u0027: \u0027chaser\u0027, \u0027floor\u0027: 2},\n        {\u0027type\u0027: \u0027sniper\u0027, \u0027floor\u0027: 1},\n        {\u0027type\u0027: \u0027patrol\u0027, \u0027floor\u0027: 1},\n        {\u0027type\u0027: \u0027chaser\u0027, \u0027floor\u0027: 0},\n        {\u0027type\u0027: \u0027sniper\u0027, \u0027floor\u0027: 0},\n    ],\n    \u0027rewards\u0027: copy.deepcopy(TARGET_REWARD_CONTRACT),\n}\nCURRICULUM[12] \u003d copy.deepcopy(TARGET_SCENARIO)\n\n\ndef get_level_config(level, benchmark\u003dFalse):\n    if benchmark or level in (\u0027target\u0027, \u0027benchmark\u0027):\n        return copy.deepcopy(TARGET_SCENARIO)\n    cfg \u003d copy.deepcopy(CURRICULUM[level])\n    cfg.setdefault(\u0027rewards\u0027, {})\n    return cfg\n\n\ndef _scan_positions(floors, tile_value):\n    positions \u003d []\n    for f, grid in enumerate(floors):\n        h, w \u003d grid.shape\n        for y in range(h):\n            for x in range(w):\n                if int(grid[y][x]) \u003d\u003d int(tile_value):\n                    positions.append((x, y, f))\n    return positions\n\n\ndef _build_stair_links(floors):\n    up_links, down_links \u003d {}, {}\n    for f, grid in enumerate(floors):\n        h, w \u003d grid.shape\n        for y in range(h):\n            for x in range(w):\n                tile \u003d int(grid[y][x])\n                if tile \u003d\u003d int(Tile.STAIR_UP) and f + 1 \u003c len(floors):\n                    up_links[(x, y, f)] \u003d (x, y, f + 1)\n                elif tile \u003d\u003d int(Tile.STAIR_DOWN) and f \u003e 0:\n                    down_links[(x, y, f)] \u003d (x, y, f - 1)\n    return up_links, down_links\n\n\ndef solve_progression_path(floors, start, goal, initial_keys\u003d0, door_positions\u003dNone, key_positions\u003dNone):\n    if not floors:\n        return None, None\n    door_positions \u003d [pos for pos in (door_positions or _scan_positions(floors, Tile.DOOR))\n                      if int(floors[pos[2]][pos[1]][pos[0]]) \u003d\u003d int(Tile.DOOR)]\n    key_positions \u003d [pos for pos in (key_positions or _scan_positions(floors, Tile.KEY))\n                     if int(floors[pos[2]][pos[1]][pos[0]]) \u003d\u003d int(Tile.KEY)]\n    door_index \u003d {pos: i for i, pos in enumerate(door_positions)}\n    key_index \u003d {pos: i for i, pos in enumerate(key_positions)}\n    up_links, down_links \u003d _build_stair_links(floors)\n    h, w \u003d floors[0].shape\n\n    start_state \u003d (start[0], start[1], start[2], int(initial_keys), 0, 0)\n    q \u003d deque([(start_state, 0)])\n    parent \u003d {start_state: None}\n    seen \u003d {start_state}\n\n    while q:\n        state, dist \u003d q.popleft()\n        x, y, f, keys, key_mask, door_mask \u003d state\n        if (x, y, f) \u003d\u003d goal:\n            path \u003d []\n            cur \u003d state\n            while cur is not None:\n                path.append(cur)\n                cur \u003d parent[cur]\n            path.reverse()\n            return dist, path\n\n        neighbors \u003d []\n        for dx, dy in [(0, 1), (0, -1), (1, 0), (-1, 0)]:\n            nx, ny, nf \u003d x + dx, y + dy, f\n            if 0 \u003c\u003d nx \u003c w and 0 \u003c\u003d ny \u003c h:\n                neighbors.append((nx, ny, nf))\n        if (x, y, f) in up_links:\n            neighbors.append(up_links[(x, y, f)])\n        if (x, y, f) in down_links:\n            neighbors.append(down_links[(x, y, f)])\n\n        for nx, ny, nf in neighbors:\n            tile \u003d int(floors[nf][ny][nx])\n            if tile \u003d\u003d int(Tile.WALL):\n                continue\n            n_keys, n_key_mask, n_door_mask \u003d keys, key_mask, door_mask\n            pos \u003d (nx, ny, nf)\n            if pos in door_index:\n                bit \u003d 1 \u003c\u003c door_index[pos]\n                if not (door_mask \u0026 bit):\n                    if n_keys \u003c\u003d 0:\n                        continue\n                    n_keys -\u003d 1\n                    n_door_mask |\u003d bit\n            if pos in key_index:\n                bit \u003d 1 \u003c\u003c key_index[pos]\n                if not (key_mask \u0026 bit):\n                    n_keys +\u003d 1\n                    n_key_mask |\u003d bit\n            new_state \u003d (nx, ny, nf, n_keys, n_key_mask, n_door_mask)\n            if new_state in seen:\n                continue\n            seen.add(new_state)\n            parent[new_state] \u003d state\n            q.append((new_state, dist + 1))\n    return None, None\n\n\ndef first_progress_objective(path_states, goal, key_positions\u003dNone, door_positions\u003dNone):\n    if not path_states:\n        return goal\n    key_positions \u003d set(key_positions or [])\n    door_positions \u003d set(door_positions or [])\n    for prev, cur in zip(path_states, path_states[1:]):\n        pos \u003d (cur[0], cur[1], cur[2])\n        if cur[4] !\u003d prev[4] and pos in key_positions:\n            return pos\n        if cur[5] !\u003d prev[5] and pos in door_positions:\n            return pos\n    return goal\n\n\nclass StableProceduralMapGenerator(ProceduralMapGenerator):\n    def _mark_used(self, used, pos, floor_idx):\n        used.add((pos[0], pos[1], floor_idx))\n\n    def _pick_floor(self, grid, used\u003dNone, floor_idx\u003d0):\n        used \u003d used or set()\n        h, w \u003d grid.shape\n        tiles \u003d [(x, y) for y in range(1, h - 1) for x in range(1, w - 1)\n                 if int(grid[y][x]) \u003d\u003d int(Tile.FLOOR) and (x, y, floor_idx) not in used]\n        if not tiles:\n            raise ValueError(f\u0027No free floor tile on floor {floor_idx}\u0027)\n        return self.rng.choice(tiles)\n\n    def _pick_in_room(self, grid, room, used, floor_idx\u003d0):\n        rx, ry, rw, rh \u003d room\n        h, w \u003d grid.shape\n        cands \u003d [(x, y) for y in range(max(1, ry), min(h - 1, ry + rh))\n                         for x in range(max(1, rx), min(w - 1, rx + rw))\n                 if int(grid[y][x]) \u003d\u003d int(Tile.FLOOR) and (x, y, floor_idx) not in used]\n        if cands:\n            return self.rng.choice(cands)\n        return self._pick_floor(grid, used, floor_idx)\n\n    def _clear_pocket(self, grid, x, y):\n        h, w \u003d grid.shape\n        for ny in range(max(1, y - 1), min(h - 1, y + 2)):\n            for nx in range(max(1, x - 1), min(w - 1, x + 2)):\n                grid[ny][nx] \u003d Tile.FLOOR\n\n    def _place_stairs_link(self, all_f, all_r, used, fi):\n        h, w \u003d all_f[fi].shape\n        best_score, best_xy \u003d float(\u0027inf\u0027), (w // 2, h // 2)\n        for ra in all_r[fi]:\n            ac \u003d (ra[0] + ra[2] // 2, ra[1] + ra[3] // 2)\n            for rb in all_r[fi + 1]:\n                bc \u003d (rb[0] + rb[2] // 2, rb[1] + rb[3] // 2)\n                x \u003d max(1, min(w - 2, int(round((ac[0] + bc[0]) / 2))))\n                y \u003d max(1, min(h - 2, int(round((ac[1] + bc[1]) / 2))))\n                score \u003d abs(ac[0] - bc[0]) + abs(ac[1] - bc[1])\n                if score \u003c best_score:\n                    best_score, best_xy \u003d score, (x, y)\n        stx, sty \u003d best_xy\n        self._clear_pocket(all_f[fi], stx, sty)\n        self._clear_pocket(all_f[fi + 1], stx, sty)\n        all_f[fi][sty][stx] \u003d Tile.STAIR_UP\n        all_f[fi + 1][sty][stx] \u003d Tile.STAIR_DOWN\n        self._mark_used(used, (stx, sty), fi)\n        self._mark_used(used, (stx, sty), fi + 1)\n        return stx, sty\n\n    def _find_door_candidate(self, grid, rooms, entry_pos, exit_pos):\n        path \u003d self._bfs_tile_path(grid, entry_pos[0], entry_pos[1], exit_pos[0], exit_pos[1])\n        if not path or len(path) \u003c 4:\n            return None\n        middle \u003d path[len(path) // 4: max(len(path) // 4 + 1, len(path) * 3 // 4)]\n        for cx, cy in middle:\n            if self._in_any_room(cx, cy, rooms):\n                continue\n            passable_neighbors \u003d 0\n            for dx, dy in [(0, 1), (0, -1), (1, 0), (-1, 0)]:\n                nx, ny \u003d cx + dx, cy + dy\n                if 0 \u003c\u003d nx \u003c grid.shape[1] and 0 \u003c\u003d ny \u003c grid.shape[0]:\n                    if int(grid[ny][nx]) !\u003d int(Tile.WALL):\n                        passable_neighbors +\u003d 1\n            if passable_neighbors \u003c\u003d 2:\n                return (cx, cy)\n        for cx, cy in middle:\n            if not self._in_any_room(cx, cy, rooms):\n                return (cx, cy)\n        return None\n\n    def _reachable_before_current_lock(self, all_f, start, staged_door\u003dNone):\n        temp_f \u003d [g.copy() for g in all_f]\n        for grid in temp_f:\n            grid[grid \u003d\u003d Tile.DOOR] \u003d Tile.FLOOR\n        if staged_door is not None:\n            dx, dy, df \u003d staged_door\n            temp_f[df][dy][dx] \u003d Tile.DOOR\n        return self._bfs_reachable_set(temp_f, start, {int(Tile.DOOR)})\n\n    def _place_lock(self, all_f, all_r, all_g, kf, df, start, goal, used):\n        grid \u003d all_f[df]\n        rooms \u003d all_r[df]\n        h, w \u003d grid.shape\n        sx, sy, sf \u003d start\n        gx, gy, gf \u003d goal\n        entry \u003d (sx, sy)\n        exit_ \u003d (gx, gy)\n        if df !\u003d sf:\n            stair_pos \u003d self._find_stair_toward(grid, df, sf, h, w)\n            if not stair_pos:\n                return None\n            entry \u003d stair_pos\n        if df !\u003d gf:\n            stair_pos \u003d self._find_stair_toward(grid, df, gf, h, w)\n            if not stair_pos:\n                return None\n            exit_ \u003d stair_pos\n        door_xy \u003d self._find_door_candidate(grid, rooms, entry, exit_)\n        if door_xy is None:\n            return None\n        dx, dy \u003d door_xy\n        test_grid \u003d grid.copy()\n        test_grid[test_grid \u003d\u003d Tile.DOOR] \u003d Tile.FLOOR\n        test_grid[dy][dx] \u003d Tile.DOOR\n        if self._bfs_tile_connected(test_grid, entry[0], entry[1], exit_[0], exit_[1], {int(Tile.DOOR)}):\n            return None\n\n        reachable \u003d self._reachable_before_current_lock(all_f, start, staged_door\u003d(dx, dy, df))\n        key_candidates \u003d []\n        for room in all_r[kf]:\n            for y in range(max(1, room[1]), min(all_f[kf].shape[0] - 1, room[1] + room[3])):\n                for x in range(max(1, room[0]), min(all_f[kf].shape[1] - 1, room[0] + room[2])):\n                    pos3 \u003d (x, y, kf)\n                    if pos3 in reachable and int(all_f[kf][y][x]) \u003d\u003d int(Tile.FLOOR) and pos3 not in used:\n                        score \u003d abs(x - start[0]) + abs(y - start[1]) + abs(kf - start[2]) * 10\n                        key_candidates.append((score, x, y))\n        if not key_candidates:\n            return None\n        _, kx, ky \u003d max(key_candidates)\n        all_f[df][dy][dx] \u003d Tile.DOOR\n        all_f[kf][ky][kx] \u003d Tile.KEY\n        self._mark_used(used, (dx, dy), df)\n        self._mark_used(used, (kx, ky), kf)\n        return {\u0027door\u0027: (dx, dy, df), \u0027key\u0027: (kx, ky, kf)}\n\n    def _spawn_enemy_layout(self, all_f, all_r, start, goal, config, used):\n        enemy_spawns \u003d []\n        for ec in config.get(\u0027enemies\u0027, []):\n            ef \u003d ec.get(\u0027floor\u0027, 0)\n            grid \u003d all_f[ef]\n            candidates \u003d []\n            for y in range(1, grid.shape[0] - 1):\n                for x in range(1, grid.shape[1] - 1):\n                    pos \u003d (x, y, ef)\n                    if pos in used or int(grid[y][x]) !\u003d int(Tile.FLOOR):\n                        continue\n                    if abs(x - start[0]) + abs(y - start[1]) + abs(ef - start[2]) * 10 \u003c 6:\n                        continue\n                    if abs(x - goal[0]) + abs(y - goal[1]) + abs(ef - goal[2]) * 10 \u003c 4:\n                        continue\n                    candidates.append(pos)\n            if not candidates:\n                raise ValueError(f\u0027No spawn tile for enemy {ec}\u0027)\n            pos \u003d self.rng.choice(candidates)\n            enemy_spawns.append({\u0027type\u0027: ec.get(\u0027type\u0027, \u0027patrol\u0027), \u0027x\u0027: pos[0], \u0027y\u0027: pos[1], \u0027floor\u0027: pos[2]})\n            used.add(pos)\n        return enemy_spawns\n\n    def _bfs_multi(self, floors, start, goal):\n        dist, _ \u003d solve_progression_path(floors, start, goal, initial_keys\u003d0)\n        return -1 if dist is None else dist\n\n    def validate(self, map_data, config):\n        floors \u003d map_data[\u0027floors\u0027]\n        w, h \u003d map_data[\u0027width\u0027], map_data[\u0027height\u0027]\n        start, goal \u003d map_data[\u0027start\u0027], map_data[\u0027goal\u0027]\n        for f, grid in enumerate(floors):\n            if np.sum(grid !\u003d Tile.WALL) / float(w * h) \u003c 0.20:\n                return False, f\u0027low_floor_ratio_{f}\u0027\n        door_positions \u003d map_data.get(\u0027door_positions\u0027, [])\n        key_positions \u003d map_data.get(\u0027key_positions\u0027, [])\n        if len(door_positions) !\u003d len(config.get(\u0027locks\u0027, [])):\n            return False, \u0027door_count_mismatch\u0027\n        if len(key_positions) !\u003d len(config.get(\u0027locks\u0027, [])):\n            return False, \u0027key_count_mismatch\u0027\n        dist, path \u003d solve_progression_path(floors, start, goal, 0, door_positions, key_positions)\n        if dist is None:\n            return False, \u0027unsolved_stateful\u0027\n        if dist \u003c max(w, h):\n            return False, \u0027too_short\u0027\n        events \u003d []\n        if path:\n            for prev, cur in zip(path, path[1:]):\n                pos \u003d (cur[0], cur[1], cur[2])\n                if cur[4] !\u003d prev[4]:\n                    events.append((\u0027key\u0027, pos))\n                if cur[5] !\u003d prev[5]:\n                    events.append((\u0027door\u0027, pos))\n        key_events \u003d [pos for kind, pos in events if kind \u003d\u003d \u0027key\u0027]\n        door_events \u003d [pos for kind, pos in events if kind \u003d\u003d \u0027door\u0027]\n        if len(key_events) \u003c len(key_positions) or len(door_events) \u003c len(door_positions):\n            return False, \u0027progression_incomplete\u0027\n        required_enemy_types \u003d set(config.get(\u0027required_enemy_types\u0027, []))\n        spawned_enemy_types \u003d {e[\u0027type\u0027] for e in map_data.get(\u0027enemy_spawns\u0027, [])}\n        if not required_enemy_types.issubset(spawned_enemy_types):\n            return False, \u0027enemy_mix_incomplete\u0027\n        return True, \u0027ok\u0027\n\n    def generate(self, config, max_retries\u003d60):\n        last_error \u003d \u0027unknown\u0027\n        for _ in range(max_retries):\n            try:\n                md \u003d self._generate_once(config)\n                ok, reason \u003d self.validate(md, config)\n                if ok:\n                    return md\n                last_error \u003d reason\n            except Exception as exc:\n                last_error \u003d str(exc)\n        raise ValueError(f\u0027Failed to generate a valid target map after {max_retries} retries: {last_error}\u0027)\n\n    def _generate_once(self, config):\n        nf \u003d config.get(\u0027n_floors\u0027, 1)\n        w \u003d config.get(\u0027width\u0027, 12)\n        h \u003d config.get(\u0027height\u0027, 12)\n        all_f, all_r, all_g \u003d [], [], []\n        for _ in range(nf):\n            grid, rooms, graph \u003d self._gen_floor(w, h, add_loops\u003dFalse)\n            all_f.append(grid)\n            all_r.append(rooms)\n            all_g.append(graph)\n\n        used \u003d set()\n        for fi in range(nf - 1):\n            self._place_stairs_link(all_f, all_r, used, fi)\n\n        sf \u003d config.get(\u0027start_floor\u0027, nf - 1)\n        gf \u003d config.get(\u0027goal_floor\u0027, 0)\n        start_room \u003d max(all_r[sf], key\u003dlambda r: r[0] + r[1])\n        goal_room \u003d min(all_r[gf], key\u003dlambda r: r[0] + r[1])\n        sp \u003d self._pick_in_room(all_f[sf], start_room, used, sf)\n        gp \u003d self._pick_in_room(all_f[gf], goal_room, used, gf)\n        self._mark_used(used, sp, sf)\n        self._mark_used(used, gp, gf)\n        all_f[sf][sp[1]][sp[0]] \u003d Tile.START\n        all_f[gf][gp[1]][gp[0]] \u003d Tile.GOAL\n        start \u003d (sp[0], sp[1], sf)\n        goal \u003d (gp[0], gp[1], gf)\n\n        door_positions, key_positions \u003d [], []\n        for lock in config.get(\u0027locks\u0027, []):\n            placed \u003d self._place_lock(all_f, all_r, all_g, lock.get(\u0027k\u0027, 0), lock.get(\u0027d\u0027, 0), start, goal, used)\n            if not placed:\n                raise ValueError(\u0027lock_chain_failed\u0027)\n            door_positions.append(placed[\u0027door\u0027])\n            key_positions.append(placed[\u0027key\u0027])\n\n        for fi in range(nf):\n            rooms \u003d all_r[fi]\n            graph \u003d all_g[fi]\n            grid \u003d all_f[fi]\n            if not rooms:\n                continue\n            si \u003d self._closest_room(start[0], start[1], rooms) if fi \u003d\u003d sf else 0\n            gi \u003d self._closest_room(goal[0], goal[1], rooms) if fi \u003d\u003d gf else len(rooms) - 1\n            cp \u003d self._critical_path(graph, si, gi, len(rooms))\n            zones \u003d self._assign_zones(rooms, graph, cp, sum(1 for e in config.get(\u0027enemies\u0027, []) if e.get(\u0027floor\u0027, 0) \u003d\u003d fi))\n            trap_rooms \u003d [i for i in range(len(rooms)) if zones.get(i) in (\u0027passage\u0027, \u0027combat\u0027, \u0027treasure\u0027)]\n            health_rooms \u003d [i for i in range(len(rooms)) if zones.get(i) in (\u0027spawn\u0027, \u0027passage\u0027, \u0027treasure\u0027)]\n            ammo_rooms \u003d [i for i in range(len(rooms)) if zones.get(i) in (\u0027combat\u0027, \u0027passage\u0027, \u0027treasure\u0027)]\n            for _ in range(config.get(\u0027n_traps\u0027, 0) // max(1, nf)):\n                ri \u003d self.rng.choice(trap_rooms or [0])\n                tx, ty \u003d self._pick_in_room(grid, rooms[ri], used, fi)\n                grid[ty][tx] \u003d Tile.TRAP\n                self._mark_used(used, (tx, ty), fi)\n            for _ in range(config.get(\u0027n_health\u0027, 0) // max(1, nf)):\n                ri \u003d self.rng.choice(health_rooms or [0])\n                hx, hy \u003d self._pick_in_room(grid, rooms[ri], used, fi)\n                grid[hy][hx] \u003d Tile.HEALTH_PACK\n                self._mark_used(used, (hx, hy), fi)\n            for _ in range(config.get(\u0027n_ammo\u0027, 0) // max(1, nf)):\n                ri \u003d self.rng.choice(ammo_rooms or [0])\n                ax, ay \u003d self._pick_in_room(grid, rooms[ri], used, fi)\n                grid[ay][ax] \u003d Tile.AMMO_PACK\n                self._mark_used(used, (ax, ay), fi)\n\n        enemy_spawns \u003d self._spawn_enemy_layout(all_f, all_r, start, goal, config, used)\n        return {\n            \u0027floors\u0027: all_f,\n            \u0027n_floors\u0027: nf,\n            \u0027width\u0027: w,\n            \u0027height\u0027: h,\n            \u0027start\u0027: start,\n            \u0027goal\u0027: goal,\n            \u0027door_positions\u0027: door_positions,\n            \u0027key_positions\u0027: key_positions,\n            \u0027enemy_spawns\u0027: enemy_spawns,\n            \u0027target_name\u0027: config.get(\u0027name\u0027, \u0027UnnamedTarget\u0027),\n        }\n\n\nclass TargetObservationBuilder(ObservationBuilder):\n    def build(self, grid, agent, enemies, bpos, lasers, nf, target_3d, max_steps\u003d200):\n        obs, vec \u003d super().build(grid, agent, enemies, bpos, lasers, nf, target_3d, max_steps)\n        max_keys \u003d max(1, getattr(agent, \u0027max_keys\u0027, 1))\n        vec[3] \u003d np.clip((agent.keys / max_keys) * 2 - 1, -1, 1)\n        return obs, vec\n\n\nclass TargetNeuroInfiltratorEnv(NeuroInfiltratorEnv):\n    def __init__(self, config\u003dNone, render_mode\u003d\u0027rgb_array\u0027):\n        super().__init__(config\u003dconfig, render_mode\u003drender_mode)\n        self.obs_builder \u003d TargetObservationBuilder(self.vr)\n        self.R \u003d copy.deepcopy(TARGET_REWARD_CONTRACT)\n        self.R.update(self.cfg.get(\u0027rewards\u0027, {}))\n        self.success \u003d False\n        self.objective \u003d None\n        self.key_positions \u003d []\n        self.door_positions \u003d []\n        self.target_name \u003d self.cfg.get(\u0027name\u0027, \u0027UnnamedTarget\u0027)\n\n    def reset(self, seed\u003dNone, options\u003dNone):\n        if options and options.get(\u0027same_map\u0027) and hasattr(self, \u0027initial_map_data\u0027):\n            md \u003d self.initial_map_data\n        elif options and \u0027map_data\u0027 in options:\n            md \u003d options[\u0027map_data\u0027]\n        else:\n            md \u003d ProceduralMapGenerator(seed).generate(self.cfg)\n        self.initial_map_data \u003d md\n        self.target_name \u003d md.get(\u0027target_name\u0027, self.cfg.get(\u0027name\u0027, \u0027UnnamedTarget\u0027))\n        self.floors \u003d [g.copy() for g in md[\u0027floors\u0027]]\n        self.nf \u003d md[\u0027n_floors\u0027]\n        self.mw \u003d md[\u0027width\u0027]\n        self.mh \u003d md[\u0027height\u0027]\n        sx, sy, sf \u003d md[\u0027start\u0027]\n        self.goal \u003d md[\u0027goal\u0027]\n        self.key_positions \u003d list(md.get(\u0027key_positions\u0027, []))\n        self.door_positions \u003d list(md.get(\u0027door_positions\u0027, []))\n        hp \u003d self.cfg.get(\u0027agent_hp\u0027, 3)\n        ammo \u003d self.cfg.get(\u0027agent_ammo\u0027, 3)\n        stamina \u003d self.cfg.get(\u0027agent_stamina\u0027, 3)\n        self.agent \u003d AgentState(sx, sy, sf, hp, ammo, stamina)\n        self.agent.max_ammo \u003d self.cfg.get(\u0027agent_max_ammo\u0027, 5)\n        self.agent.max_keys \u003d max(1, len(self.key_positions))\n        self.enemies \u003d []\n        enemy_specs \u003d md.get(\u0027enemy_spawns\u0027, []) or self.cfg.get(\u0027enemies\u0027, [])\n        for ec in enemy_specs:\n            ex, ey, ef \u003d ec.get(\u0027x\u0027), ec.get(\u0027y\u0027), ec.get(\u0027floor\u0027, 0)\n            if ex is None or ey is None:\n                g \u003d self.floors[ef]\n                candidates \u003d [(x, y) for y in range(self.mh) for x in range(self.mw) if int(g[y][x]) \u003d\u003d int(Tile.FLOOR)]\n                ex, ey \u003d candidates[0]\n            et \u003d ec.get(\u0027type\u0027, \u0027patrol\u0027)\n            if et \u003d\u003d \u0027patrol\u0027:\n                wps \u003d [(ex, ey)]\n                for offset in [(2, 0), (0, 2), (-2, 0)]:\n                    nx \u003d max(1, min(self.mw - 2, ex + offset[0]))\n                    ny \u003d max(1, min(self.mh - 2, ey + offset[1]))\n                    wps.append((nx, ny))\n                self.enemies.append(PatrolEnemy(ex, ey, ef, wps))\n            elif et \u003d\u003d \u0027chaser\u0027:\n                self.enemies.append(ChaserEnemy(ex, ey, ef))\n            elif et \u003d\u003d \u0027sniper\u0027:\n                self.enemies.append(SniperEnemy(ex, ey, ef))\n        self.ballistics \u003d BallisticsEngine()\n        self.stealth \u003d StealthSystem()\n        self.done \u003d False\n        self.win \u003d False\n        self.success \u003d False\n        self.total_reward \u003d 0.0\n        self.agent.steps \u003d 0\n        self.agent.visited \u003d {(sx, sy, sf)}\n        self._lasers \u003d []\n        self.objective \u003d self._dynamic_goal()\n        return self._obs(), self._info()\n\n    def _remaining_keys(self):\n        return [pos for pos in self.key_positions if int(self.floors[pos[2]][pos[1]][pos[0]]) \u003d\u003d int(Tile.KEY)]\n\n    def _remaining_doors(self):\n        return [pos for pos in self.door_positions if int(self.floors[pos[2]][pos[1]][pos[0]]) \u003d\u003d int(Tile.DOOR)]\n\n    def _mission_snapshot(self):\n        remaining_doors \u003d self._remaining_doors()\n        remaining_keys \u003d self._remaining_keys()\n        dist, path \u003d solve_progression_path(\n            self.floors,\n            (self.agent.x, self.agent.y, self.agent.floor),\n            self.goal,\n            initial_keys\u003dself.agent.keys,\n            door_positions\u003dremaining_doors,\n            key_positions\u003dremaining_keys,\n        )\n        objective \u003d first_progress_objective(path, self.goal, remaining_keys, remaining_doors)\n        return {\n            \u0027distance\u0027: 999 if dist is None else dist,\n            \u0027path\u0027: path,\n            \u0027objective\u0027: objective,\n            \u0027keys_remaining\u0027: len(remaining_keys),\n            \u0027doors_remaining\u0027: len(remaining_doors),\n        }\n\n    def _dynamic_goal(self):\n        self.objective \u003d self._mission_snapshot()[\u0027objective\u0027]\n        return self.objective\n\n    def _true_distance(self, x, y, f, target_3d):\n        dist, _ \u003d solve_progression_path(\n            self.floors,\n            (x, y, f),\n            target_3d,\n            initial_keys\u003dself.agent.keys,\n            door_positions\u003dself._remaining_doors(),\n            key_positions\u003dself._remaining_keys(),\n        )\n        return 999 if dist is None else dist\n\n    def _try_move(self, nx, ny):\n        g \u003d self.floors[self.agent.floor]\n        h, w \u003d g.shape\n        if not (0 \u003c\u003d nx \u003c w and 0 \u003c\u003d ny \u003c h):\n            return self.R[\u0027wall\u0027]\n        t \u003d int(g[ny][nx])\n        if t \u003d\u003d int(Tile.WALL):\n            return self.R[\u0027wall\u0027]\n        if t \u003d\u003d int(Tile.DOOR):\n            if self.agent.keys \u003e 0:\n                self.agent.keys -\u003d 1\n                g[ny][nx] \u003d Tile.FLOOR\n                self.agent.x, self.agent.y \u003d nx, ny\n                return self.R[\u0027door\u0027]\n            return self.R[\u0027door_lk\u0027]\n        self.agent.x, self.agent.y \u003d nx, ny\n        rv \u003d 0.0\n        if t \u003d\u003d int(Tile.TRAP):\n            self.agent.damage(1)\n            rv +\u003d self.R[\u0027trap\u0027]\n        elif t \u003d\u003d int(Tile.KEY):\n            self.agent.keys +\u003d 1\n            g[ny][nx] \u003d Tile.FLOOR\n            rv +\u003d self.R[\u0027key\u0027]\n        elif t \u003d\u003d int(Tile.HEALTH_PACK):\n            self.agent.heal(1)\n            g[ny][nx] \u003d Tile.FLOOR\n            rv +\u003d self.R[\u0027hp\u0027]\n        elif t \u003d\u003d int(Tile.AMMO_PACK):\n            self.agent.add_ammo(2)\n            g[ny][nx] \u003d Tile.FLOOR\n            rv +\u003d self.R[\u0027ammo\u0027]\n        return rv\n\n    def step(self, action):\n        if self.done:\n            return self._obs(), 0.0, True, False, self._info()\n        mission_old \u003d self._mission_snapshot()\n        self.agent.old_x, self.agent.old_y \u003d self.agent.x, self.agent.y\n        a \u003d int(action)\n        self.agent.steps +\u003d 1\n        r \u003d self.R[\u0027step\u0027]\n        g \u003d self.floors[self.agent.floor]\n        self.stealth.calc(a, self.agent)\n\n        if a in (0, 1, 2, 3):\n            dx, dy \u003d DIR_DELTA[a]\n            self.agent.last_dir \u003d (dx, dy)\n            r +\u003d self._try_move(self.agent.x + dx, self.agent.y + dy)\n        elif 4 \u003c\u003d a \u003c\u003d 7:\n            dx, dy \u003d DIR_DELTA[a - 4]\n            self.agent.last_dir \u003d (dx, dy)\n            if self.agent.use_ammo():\n                r +\u003d self.R[\u0027shoot\u0027]\n                self.ballistics.fire(self.agent.x, self.agent.y, self.agent.floor, dx, dy, \u0027agent\u0027, self.cfg.get(\u0027ricochet\u0027, 0))\n            else:\n                r +\u003d self.R[\u0027wall\u0027]\n        elif a \u003d\u003d 8:\n            if self.agent.use_stamina():\n                dx, dy \u003d self.agent.last_dir\n                for _ in range(2):\n                    nx, ny \u003d self.agent.x + dx, self.agent.y + dy\n                    if self._walk(nx, ny):\n                        r +\u003d self._try_move(nx, ny)\n                    else:\n                        break\n            else:\n                r +\u003d self.R[\u0027wall\u0027]\n        elif a \u003d\u003d 9:\n            t \u003d g[self.agent.y][self.agent.x]\n            if t \u003d\u003d Tile.STAIR_UP and self.agent.floor \u003c self.nf - 1:\n                self.agent.floor +\u003d 1\n                if (self.agent.x, self.agent.y, self.agent.floor) not in self.agent.visited:\n                    r +\u003d self.R[\u0027stairs\u0027]\n            elif t \u003d\u003d Tile.STAIR_DOWN and self.agent.floor \u003e 0:\n                self.agent.floor -\u003d 1\n                if (self.agent.x, self.agent.y, self.agent.floor) not in self.agent.visited:\n                    r +\u003d self.R[\u0027stairs\u0027]\n            else:\n                r +\u003d self.R[\u0027wall\u0027]\n\n        pk \u003d (self.agent.x, self.agent.y, self.agent.floor)\n        if pk not in self.agent.visited:\n            self.agent.visited.add(pk)\n            r +\u003d self.R[\u0027explore\u0027]\n\n        mission_new \u003d self._mission_snapshot()\n        if self.R.get(\u0027approach\u0027, 0) \u003e 0:\n            r +\u003d self.R[\u0027approach\u0027] * np.clip(mission_old[\u0027distance\u0027] - mission_new[\u0027distance\u0027], -1, 1)\n\n        for ev, _ in self.ballistics.update(g, self.enemies, self.agent):\n            if ev \u003d\u003d \u0027kill\u0027:\n                r +\u003d self.R[\u0027kill\u0027]\n            elif ev \u003d\u003d \u0027agent_hit\u0027:\n                self.agent.damage(1)\n                r +\u003d self.R[\u0027dmg\u0027]\n        self._lasers \u003d []\n        npos \u003d self.stealth.npos\n        for e in self.enemies:\n            e.old_x, e.old_y \u003d e.x, e.y\n            eg \u003d self.floors[e.floor] if e.floor \u003c self.nf else g\n            if isinstance(e, SniperEnemy):\n                proj \u003d e.update(eg, (self.agent.x, self.agent.y), self.agent.floor, self.agent.noise_level, npos)\n                if proj:\n                    self.ballistics.add(proj)\n                self._lasers.extend(e.laser_path)\n            else:\n                e.update(eg, (self.agent.x, self.agent.y), self.agent.floor, self.agent.noise_level, npos)\n\n        for b in self.ballistics.bullets:\n            if not b.alive:\n                continue\n            obx, oby \u003d b.x - b.dx, b.y - b.dy\n            if b.owner \u003d\u003d \u0027agent\u0027:\n                for e in self.enemies:\n                    if e.alive and e.floor \u003d\u003d b.floor:\n                        hit \u003d False\n                        if e.x \u003d\u003d b.x and e.y \u003d\u003d b.y:\n                            hit \u003d True\n                        elif e.x \u003d\u003d obx and e.y \u003d\u003d oby and getattr(e, \u0027old_x\u0027, -1) \u003d\u003d b.x and getattr(e, \u0027old_y\u0027, -1) \u003d\u003d b.y:\n                            hit \u003d True\n                        if hit:\n                            e.hp -\u003d 1\n                            if e.hp \u003c\u003d 0:\n                                e.alive \u003d False\n                                r +\u003d self.R[\u0027kill\u0027]\n                            b.alive \u003d False\n                            break\n            elif b.floor \u003d\u003d self.agent.floor:\n                hit \u003d False\n                if self.agent.x \u003d\u003d b.x and self.agent.y \u003d\u003d b.y:\n                    hit \u003d True\n                elif self.agent.x \u003d\u003d obx and self.agent.y \u003d\u003d oby and getattr(self.agent, \u0027old_x\u0027, -1) \u003d\u003d b.x and getattr(self.agent, \u0027old_y\u0027, -1) \u003d\u003d b.y:\n                    hit \u003d True\n                if hit:\n                    self.agent.damage(1)\n                    r +\u003d self.R[\u0027dmg\u0027]\n                    b.alive \u003d False\n\n        for e in self.enemies:\n            if e.alive and e.floor \u003d\u003d self.agent.floor:\n                d \u003d abs(e.x - self.agent.x) + abs(e.y - self.agent.y)\n                if d \u003c\u003d 1 and hasattr(e, \u0027state\u0027) and e.state in (\u0027investigate\u0027, \u0027chase\u0027):\n                    self.agent.damage(1)\n                    r +\u003d self.R[\u0027dmg\u0027]\n\n        if self.agent.steps % 5 \u003d\u003d 0:\n            self.agent.regen_stamina()\n        self.stealth.decay(self.agent)\n\n        gx, gy, gf \u003d self.goal\n        alive \u003d self.agent.alive\n        at_goal \u003d self.agent.x \u003d\u003d gx and self.agent.y \u003d\u003d gy and self.agent.floor \u003d\u003d gf\n        self.success \u003d bool(alive and at_goal and mission_new[\u0027doors_remaining\u0027] \u003d\u003d 0)\n        term \u003d False\n        if self.success:\n            r +\u003d self.R[\u0027goal\u0027]\n            term \u003d True\n            self.win \u003d True\n        elif not alive:\n            r +\u003d self.R[\u0027death\u0027]\n            term \u003d True\n            self.win \u003d False\n        trunc \u003d self.agent.steps \u003e\u003d self.max_steps\n        self.done \u003d term or trunc\n        self.total_reward +\u003d r\n        self.objective \u003d mission_new[\u0027objective\u0027]\n        return self._obs(), float(r), term, trunc, self._info()\n\n    def _obs(self):\n        g \u003d self.floors[self.agent.floor]\n        bp \u003d self.ballistics.positions(self.agent.floor)\n        dg \u003d self._dynamic_goal()\n        v, vec \u003d self.obs_builder.build(g, self.agent, self.enemies, bp, self._lasers, self.nf, dg, self.max_steps)\n        return {\u0027visual\u0027: v, \u0027vector\u0027: vec}\n\n    def _info(self):\n        mission \u003d self._mission_snapshot()\n        objective \u003d mission[\u0027objective\u0027]\n        return {\n            \u0027win\u0027: self.success,\n            \u0027success\u0027: self.success,\n            \u0027steps\u0027: self.agent.steps,\n            \u0027hp\u0027: self.agent.hp,\n            \u0027ammo\u0027: self.agent.ammo,\n            \u0027floor\u0027: self.agent.floor,\n            \u0027keys\u0027: self.agent.keys,\n            \u0027key_count\u0027: self.agent.keys,\n            \u0027keys_remaining\u0027: mission[\u0027keys_remaining\u0027],\n            \u0027doors_remaining\u0027: mission[\u0027doors_remaining\u0027],\n            \u0027objective\u0027: objective,\n            \u0027objective_type\u0027: \u0027goal\u0027 if objective \u003d\u003d self.goal else \u0027progression\u0027,\n            \u0027mission_distance\u0027: mission[\u0027distance\u0027],\n            \u0027total_reward\u0027: self.total_reward,\n            \u0027enemies_alive\u0027: sum(1 for e in self.enemies if e.alive),\n            \u0027explored\u0027: len(self.agent.visited),\n            \u0027target_name\u0027: self.target_name,\n        }\n\n\nObservationBuilder \u003d TargetObservationBuilder\nProceduralMapGenerator \u003d StableProceduralMapGenerator\nNeuroInfiltratorEnv \u003d TargetNeuroInfiltratorEnv\nprint(\u0027Target scenario + stable generator/env overrides loaded\u0027)",
