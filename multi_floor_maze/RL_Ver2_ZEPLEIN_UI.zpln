      "text": "%pyspark\nimport importlib\nimport subprocess\nimport sys\nimport random\n\n\ndef ensure_package(module_name, package_name\u003dNone):\n    try:\n        return importlib.import_module(module_name)\n    except ImportError:\n        package_name \u003d package_name or module_name\n        print(f\u0027Installing {package_name} ...\u0027)\n        subprocess.check_call([sys.executable, \u0027-m\u0027, \u0027pip\u0027, \u0027install\u0027, package_name])\n        return importlib.import_module(module_name)\n\n\nensure_package(\u0027torch\u0027)\nensure_package(\u0027stable_baselines3\u0027, \u0027stable-baselines3\u0027)\nensure_package(\u0027sb3_contrib\u0027, \u0027sb3-contrib\u0027)\n\nimport torch\nimport torch.nn as nn\nfrom stable_baselines3 import DQN\nfrom stable_baselines3.common.monitor import Monitor\nfrom stable_baselines3.common.vec_env import DummyVecEnv, VecMonitor\nfrom stable_baselines3.common.torch_layers import BaseFeaturesExtractor\nfrom sb3_contrib import RecurrentPPO\n\nTRAIN_SEED_POOL \u003d list(range(0, 512))\nEVAL_SEED_POOL \u003d list(TARGET_SCENARIO.get(\u0027benchmark_seeds\u0027, [11, 23, 37, 47, 59]))\n\n\nclass NeuroDictExtractor(BaseFeaturesExtractor):\n    def __init__(self, observation_space, features_dim\u003d256):\n        super().__init__(observation_space, features_dim)\n        visual_shape \u003d observation_space[\u0027visual\u0027].shape\n        vector_dim \u003d observation_space[\u0027vector\u0027].shape[0]\n        n_input_channels \u003d visual_shape[0]\n        self.cnn \u003d nn.Sequential(\n            nn.Conv2d(n_input_channels, 32, kernel_size\u003d3, padding\u003d1),\n            nn.ReLU(),\n            nn.Conv2d(32, 64, kernel_size\u003d3, padding\u003d1),\n            nn.ReLU(),\n            nn.Conv2d(64, 64, kernel_size\u003d3, padding\u003d1),\n            nn.ReLU(),\n            nn.Flatten(),\n        )\n        with torch.no_grad():\n            sample \u003d torch.as_tensor(observation_space[\u0027visual\u0027].sample()[None]).float()\n            cnn_dim \u003d self.cnn(sample).shape[1]\n        self.vector_net \u003d nn.Sequential(\n            nn.Linear(vector_dim, 64),\n            nn.ReLU(),\n            nn.Linear(64, 64),\n            nn.ReLU(),\n        )\n        self.fusion \u003d nn.Sequential(\n            nn.Linear(cnn_dim + 64, features_dim),\n            nn.ReLU(),\n        )\n        self._features_dim \u003d features_dim\n\n    def forward(self, observations):\n        visual_features \u003d self.cnn(observations[\u0027visual\u0027])\n        vector_features \u003d self.vector_net(observations[\u0027vector\u0027])\n        return self.fusion(torch.cat([visual_features, vector_features], dim\u003d1))\n\n\nclass SeedPoolWrapper(gym.Wrapper):\n    def __init__(self, env, seed_pool\u003dNone):\n        super().__init__(env)\n        self.seed_pool \u003d list(seed_pool or [])\n\n    def reset(self, **kwargs):\n        if \u0027seed\u0027 not in kwargs and self.seed_pool:\n            kwargs[\u0027seed\u0027] \u003d random.choice(self.seed_pool)\n        return self.env.reset(**kwargs)\n\n\ndef make_training_env(level\u003d\u0027target\u0027, train_seed_pool\u003dNone, frame_stack_k\u003dNone):\n    def _thunk():\n        benchmark \u003d level in (\u0027target\u0027, \u0027benchmark\u0027)\n        env \u003d NeuroInfiltratorEnv(get_refactor_level_config(level, benchmark\u003dbenchmark))\n        env \u003d SeedPoolWrapper(env, seed_pool\u003dtrain_seed_pool or TRAIN_SEED_POOL)\n        if frame_stack_k:\n            env \u003d FrameStackWrapper(env, k\u003dframe_stack_k)\n        env \u003d Monitor(env)\n        return env\n    return _thunk\n\n\nprint(\u0027RL dependency and extractor helpers ready\u0027)\n",
