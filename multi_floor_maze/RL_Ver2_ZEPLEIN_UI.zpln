    {
      "text": "%pyspark\nimport base64\nimport io\nfrom contextlib import redirect_stdout\nfrom PIL import Image\nimport numpy as np\n\nprint(\"🚀 Đang khởi tạo và huấn luyện siêu tốc PPO-LSTM ở Level 5...\")\nprint(\"⏳ Vui lòng đợi một chút (đã ẩn các log dài dòng để dễ theo dõi)...\")\n\n# 1. Huấn luyện PPO-LSTM và dùng redirect_stdout để \"giấu\" các log dạng bảng\nwith redirect_stdout(io.StringIO()):\n    ppo_model, ppo_summary, ppo_details \u003d train_ppo_lstm(\n        level\u003d5, \n        total_timesteps\u003d15000, # Tăng số bước vì map 11x11 to hơn\n        n_envs\u003d4,              # Chạy 4 môi trường song song cho lẹ\n        progress_bar\u003dFalse\n    )\n\nprint(\"✅ Huấn luyện hoàn tất! Đang chơi thử và tạo file GIF...\")\n\n# 2. Khởi tạo môi trường Level 5 để chạy thử\ntest_env \u003d NeuroInfiltratorEnv(get_refactor_level_config(5))\nobs, info \u003d test_env.reset()\n\nframes \u003d []\nframes.append(Image.fromarray(test_env.render()))\n\ndone \u003d False\ntrunc \u003d False\nlstm_state \u003d None\nepisode_start \u003d np.ones((1,), dtype\u003dbool)\n\nwhile not (done or trunc):\n    # Dùng policy của PPO dự đoán hành động\n    action, lstm_state \u003d ppo_model.predict(\n        obs, \n        state\u003dlstm_state, \n        episode_start\u003depisode_start, \n        deterministic\u003dTrue\n    )\n    \n    obs, reward, done, trunc, info \u003d test_env.step(action)\n    episode_start \u003d np.array([done or trunc], dtype\u003dbool)\n    frames.append(Image.fromarray(test_env.render()))\n\n# 3. Lưu thành file GIF \ngif_path \u003d \"agent_demo_lv5.gif\"\nframes[0].save(\n    gif_path, \n    format\u003d\u0027GIF\u0027, \n    save_all\u003dTrue, \n    append_images\u003dframes[1:], \n    duration\u003d250, # Tăng tốc độ khung hình một chút (250ms)\n    loop\u003d0\n)\n\n# 4. Hiển thị GIF trực tiếp bằng HTML\ngif_io \u003d io.BytesIO()\nframes[0].save(gif_io, format\u003d\u0027GIF\u0027, save_all\u003dTrue, append_images\u003dframes[1:], duration\u003d250, loop\u003d0)\ngif_base64 \u003d base64.b64encode(gif_io.getvalue()).decode(\u0027utf-8\u0027)\n\nhtml_code \u003d f\"\"\"%html\n\u003cdiv style\u003d\"text-align: center; font-family: sans-serif; background: #fff; padding: 20px; border-radius: 8px;\"\u003e\n    \u003ch3 style\u003d\"color: #4CAF50;\"\u003e🤖 Quick PPO Agent Demo - Level 5 (Explorer)\u003c/h3\u003e\n    \u003cp\u003e\u003cb\u003eSteps:\u003c/b\u003e {test_env.agent.steps} | \u003cb\u003eTotal Reward:\u003c/b\u003e {test_env.total_reward:.2f} | \u003cb\u003eWin:\u003c/b\u003e {info.get(\u0027win\u0027, False)}\u003c/p\u003e\n    \u003cp\u003e\u003ci\u003e(Đã lưu file ảnh vào máy với tên \u003cb\u003e{gif_path}\u003c/b\u003e)\u003c/i\u003e\u003c/p\u003e\n    \u003cimg src\u003d\"data:image/gif;base64,{gif_base64}\" style\u003d\"border: 2px solid #333; border-radius: 8px; width: 450px; image-rendering: pixelated; box-shadow: 0 4px 8px rgba(0,0,0,0.2);\" /\u003e\n\u003c/div\u003e\n\"\"\"\nprint(html_code)",
