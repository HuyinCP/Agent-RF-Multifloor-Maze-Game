      "text": "%pyspark\nactive_level \u003d int(globals().get(\u0027clvl\u0027, 1)) if str(globals().get(\u0027clvl\u0027, 1)).isdigit() else 1\ncfg \u003d get_refactor_level_config(active_level)\nenv \u003d NeuroInfiltratorEnv(cfg)\nobs, info \u003d env.reset()\n\n\ndef update_ui():\n    z.angularBind(\u0027frame\u0027, img_to_base64(Image.fromarray(env.render())))\n    z.angularBind(\u0027floor_info\u0027, f\u0027Floor {env.agent.floor}/{env.nf-1}\u0027)\n    z.angularBind(\u0027steps_info\u0027, f\u0027{env.agent.steps}/{env.max_steps}\u0027)\n    z.angularBind(\u0027score\u0027, f\u0027{env.total_reward:.1f}\u0027)\n    z.angularBind(\u0027hp_info\u0027, f\u0027{env.agent.hp}/{env.agent.max_hp}\u0027)\n    z.angularBind(\u0027ammo_info\u0027, f\u0027{env.agent.ammo}/{env.agent.max_ammo}\u0027)\n    z.angularBind(\u0027stam_info\u0027, f\u0027{env.agent.stamina}/{env.agent.max_stamina}\u0027)\n    z.angularBind(\u0027noise_info\u0027, str(env.agent.noise_level))\n    z.angularBind(\u0027keys_info\u0027, str(env.agent.keys))\n    z.angularBind(\u0027enemies_info\u0027, str(sum(1 for e in env.enemies if e.alive and e.floor \u003d\u003d env.agent.floor)))\n    vec \u003d obs[\u0027vector\u0027]\n    z.angularBind(\u0027target_vec\u0027, f\u0027[{int(vec[6]):+d}, {int(vec[7]):+d}, {int(vec[8]):+d}]\u0027)\n\n\nz.angularBind(\u0027lvl\u0027, cfg[\u0027name\u0027])\nz.angularBind(\u0027status\u0027, \u0027Refactor V2 Ready\u0027)\nupdate_ui()\nprint(f\"Refactor V2 env ready | Level: {cfg[\u0027name\u0027]} | RewardSpec: {env.reward_spec}\")\n",
