    {
      "text": "%pyspark\nimport copy\nimport numpy as np\n\nTARGET_REWARD_CONTRACT_V2 \u003d {\n    \u0027step\u0027: -0.02,\n    \u0027wall\u0027: -0.12,\n    \u0027goal\u0027: 25.0,\n    \u0027key\u0027: 2.5,\n    \u0027door\u0027: 3.5,\n    \u0027door_lk\u0027: -0.15,\n    \u0027kill\u0027: 1.25,\n    \u0027dmg\u0027: -2.0,\n    \u0027death\u0027: -18.0,\n    \u0027stairs\u0027: 0.75,\n    \u0027explore\u0027: 0.05,\n    \u0027trap\u0027: -2.5,\n    \u0027hp\u0027: 0.75,\n    \u0027ammo\u0027: 0.50,\n    \u0027approach\u0027: 0.05,\n    \u0027shoot\u0027: -0.04,\n}\n\nTARGET_REWARD_CONTRACT \u003d copy.deepcopy(TARGET_REWARD_CONTRACT_V2)\nTARGET_SCENARIO[\u0027rewards\u0027] \u003d copy.deepcopy(TARGET_REWARD_CONTRACT_V2)\n\nLegacyObservationBuilder \u003d globals().get(\u0027LegacyObservationBuilder\u0027, ObservationBuilder)\nLegacyNeuroInfiltratorEnv \u003d globals().get(\u0027LegacyNeuroInfiltratorEnv\u0027, NeuroInfiltratorEnv)\n\n\ndef _coarse_objective_reference(grid, agent, target_3d):\n    gx, gy, gf \u003d target_3d\n    if gf \u003d\u003d agent.floor:\n        return gx, gy, gf\n    target_stair \u003d Tile.STAIR_UP if gf \u003e agent.floor else Tile.STAIR_DOWN\n    best \u003d (agent.x, agent.y)\n    best_d \u003d float(\u0027inf\u0027)\n    h, w \u003d grid.shape\n    for sy in range(h):\n        for sx in range(w):\n            if int(grid[sy][sx]) \u003d\u003d int(target_stair):\n                d \u003d abs(sx - agent.x) + abs(sy - agent.y)\n                if d \u003c best_d:\n                    best_d \u003d d\n                    best \u003d (sx, sy)\n    return best[0], best[1], gf\n\n\nclass RefactorObservationBuilderV2(LegacyObservationBuilder):\n    N_CHANNELS \u003d 16\n    N_VEC \u003d 15\n\n    def build(self, grid, agent, enemies, bpos, lasers, nf, target_3d, max_steps\u003d200):\n        obs, _ \u003d LegacyObservationBuilder.build(self, grid, agent, enemies, bpos, lasers, nf, target_3d, max_steps)\n        gx, gy, gf \u003d target_3d\n        ref_x, ref_y, _ \u003d _coarse_objective_reference(grid, agent, target_3d)\n        local_visited_density \u003d float(obs[15].mean() * 2.0 - 1.0)\n        min_enemy_dist \u003d float(\u0027inf\u0027)\n        for e in enemies:\n            if e.alive and e.floor \u003d\u003d agent.floor:\n                min_enemy_dist \u003d min(min_enemy_dist, abs(e.x - agent.x) + abs(e.y - agent.y))\n        enemy_prox \u003d -1.0 if min_enemy_dist \u003d\u003d float(\u0027inf\u0027) else (1.0 - min_enemy_dist / max(1, grid.shape[0] + grid.shape[1])) * 2.0 - 1.0\n        time_rem \u003d (1.0 - agent.steps / max(1, max_steps)) * 2.0 - 1.0\n        cur_tile \u003d int(grid[agent.y][agent.x])\n        on_stair \u003d 1.0 if cur_tile in (Tile.STAIR_UP, Tile.STAIR_DOWN) else -1.0\n        floor_ratio \u003d (agent.floor / max(1, nf - 1) if nf \u003e 1 else 0.0) * 2.0 - 1.0\n        key_ratio \u003d (agent.keys / max(1, getattr(agent, \u0027max_keys\u0027, max(1, agent.keys, 1)))) * 2.0 - 1.0\n        vec \u003d np.array([\n            (agent.hp / max(1, agent.max_hp)) * 2.0 - 1.0,\n            (agent.ammo / max(1, agent.max_ammo)) * 2.0 - 1.0,\n            (agent.stamina / max(1, agent.max_stamina)) * 2.0 - 1.0,\n            np.clip(key_ratio, -1.0, 1.0),\n            np.clip((agent.noise_level / 10.0) * 2.0 - 1.0, -1.0, 1.0),\n            np.clip(floor_ratio, -1.0, 1.0),\n            float(np.sign(ref_x - agent.x)),\n            float(np.sign(ref_y - agent.y)),\n            float(np.sign(gf - agent.floor)),\n            float(agent.last_dir[0]),\n            float(agent.last_dir[1]),\n            np.clip(time_rem, -1.0, 1.0),\n            np.clip(local_visited_density, -1.0, 1.0),\n            on_stair,\n            np.clip(enemy_prox, -1.0, 1.0),\n        ], dtype\u003dnp.float32)\n        return obs, vec\n\n\nclass RefactorNeuroInfiltratorEnvV2(LegacyNeuroInfiltratorEnv):\n    def __init__(self, config\u003dNone, render_mode\u003d\u0027rgb_array\u0027):\n        super().__init__(config\u003dconfig, render_mode\u003drender_mode)\n        self.obs_builder \u003d RefactorObservationBuilderV2(self.vr)\n        self.R \u003d copy.deepcopy(TARGET_REWARD_CONTRACT_V2)\n        self.R.update(self.cfg.get(\u0027reward_overrides\u0027, {}))\n        self.reward_spec \u003d \u0027v2_generalization\u0027\n\n    def _info(self):\n        info \u003d super()._info()\n        info[\u0027reward_spec\u0027] \u003d self.reward_spec\n        info[\u0027observation_spec\u0027] \u003d \u0027coarse_objective_direction_v2\u0027\n        return info\n\n\ndef get_refactor_level_config(level, benchmark\u003dFalse, reward_overrides\u003dNone):\n    cfg \u003d copy.deepcopy(get_level_config(level, benchmark\u003dbenchmark))\n    cfg.pop(\u0027rewards\u0027, None)\n    cfg[\u0027reward_mode\u0027] \u003d \u0027v2\u0027\n    cfg[\u0027reward_overrides\u0027] \u003d reward_overrides or {}\n    return cfg\n\n\nObservationBuilder \u003d RefactorObservationBuilderV2\nNeuroInfiltratorEnv \u003d RefactorNeuroInfiltratorEnvV2\nprint(\u0027Refactor v2 observation/reward overrides loaded\u0027)\n",
      "user": "anonymous",
